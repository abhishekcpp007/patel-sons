# Public URL of the deployed site (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://patelsons.in

# --- Sign up with Google ---
# Create an OAuth 2.0 Client ID (Web application) at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string (32+ chars) used to sign session cookies:  openssl rand -base64 32
AUTH_SECRET=
# Development only: enables a fake sign-in form on /signup that skips Google. NEVER set in production.
AUTH_DEV_LOGIN=false

# --- SEO / analytics ---
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification token (content="..." value)
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token
BING_SITE_VERIFICATION=

# --- Staff panel (/admin): set a long random token; staff enter it once to update order & complaint status
ADMIN_TOKEN=

# --- Data storage ---
# Backend (Railway): set to ${{ MySQL.MYSQL_URL }} so leads/users/tickets/reviews are stored in MySQL.
# Leave empty locally to use JSON files in ./data.
MYSQL_URL=
# Frontend (Vercel): URL of the Railway backend; /api/* is proxied there. Read at build time.
BACKEND_URL=
